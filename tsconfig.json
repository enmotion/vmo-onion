{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

     /* 路径相对于当前 tsconfig.json，无需 baseUrl */
     "paths": {
       "@src": ["./src"], // 与 Vite alias 保持一致
       "@src/*": ["./src/*"], // 支持子路径导入
       "@type": ["./types"], // 与 Vite alias 保持一致
       "@type/*": ["./types/*"], // 支持子路径导入
       "@comps": ["./components"], // 与 Vite alias 保持一致
       "@comps/*": ["./components/*"], // 支持子路径导入
       "@lib": ["./use.lib"], // 与 Vite alias 保持一致
       "@lib/*": ["./use.lib/*"], // 支持子路径导入
     }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "types/**/*.ts", "use.lib/**/*.ts", "components/**/*.ts", "components/**/*.tsx", "components/**/*.vue"],
  "exclude": ["src/main.ts", "src/config/index.ts","src/vite-env.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
