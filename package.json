{
  "name": "vmo-onion",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "description": "Promise onion model",
  "main": "./dist/vmo-onion.umd.cjs",
  "module": "./dist/vmo-onion.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vmo-onion.js",
      "require": "./dist/vmo-onion.umd.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:run": "vitest run",
    "test:e2e": "npm run build && node test/e2e/package.mjs",
    "prepack": "npm run build",
    "check": "npm run coverage && npm run test:e2e",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run build && node test/e2e/docs.mjs && npm run docs:build"
  },
  "devDependencies": {
    "@types/md5": "^2.3.5",
    "@types/node": "^20.10.4",
    "@types/ramda": "^0.30.2",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^2.1.5",
    "autoprefixer": "^10.4.16",
    "jsdom": "^25.0.1",
    "md5": "^2.3.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.4",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.5",
    "vue": "^3.4.27",
    "vue-tsc": "^1.8.22"
  },
  "peerDependencies": {
    "ramda": "^0.30.0"
  }
}
